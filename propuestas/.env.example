# URL pública del subdominio (sin barra final)
PUBLIC_URL=https://propuestas.deersystems.net

# URL pública del portal de clientes. El mismo contenedor atiende los dos subdominios según el Host.
PARTNERS_URL=https://partners.deersystems.net

# Cliente OAuth de Google (tipo "Aplicación web"). URIs de redirección autorizadas:
#   https://propuestas.deersystems.net/auth/google/callback
#   https://partners.deersystems.net/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firma de la cookie de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Superusuario: siempre puede entrar y autoriza otros correos desde el panel
SUPERADMIN_EMAIL=ceo@deersystems.net

# Cifra las claves de IA y el token de Google guardados en la base. Si no se define, se usa SESSION_SECRET.
# Genera uno con: openssl rand -hex 32. Si lo cambias, vuelve a guardar las claves y a conectar Google.
ENCRYPTION_KEY=

# Claves de IA opcionales: también se pueden cargar desde Configuración en el panel (tienen prioridad).
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Opcionales
# MAX_UPLOAD_MB=100
# HOME_URL=https://deersystems.net

# Solo en local: entra sin Google en http://localhost:3000/auth/dev y http://partners.localhost:3000/auth/dev
# PUBLIC_URL=http://localhost:3000
# PARTNERS_URL=http://partners.localhost:3000
# DEV_LOGIN=1
