# URL pública del subdominio (sin barra final)
PUBLIC_URL=https://propuestas.deersystems.net

# Cliente OAuth de Google (tipo "Aplicación web").
# URI de redirección autorizada: https://propuestas.deersystems.net/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firma de la cookie de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET=17eaa417ae20997a9fd9da3bd019406f67fcdc45771c99c0d6464b47ce889eb7

# Superusuario: siempre puede entrar y autoriza otros correos desde el panel
SUPERADMIN_EMAIL=ceo@deersystems.net

# Opcionales
# MAX_UPLOAD_MB=100
# HOME_URL=https://deersystems.net

# Solo en local: entra sin Google en http://localhost:3000/auth/dev
# PUBLIC_URL=http://localhost:3000
# DEV_LOGIN=1
